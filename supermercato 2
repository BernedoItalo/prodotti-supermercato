#include <iostream>
#include <string>

using namespace std;

//prdoto none/prezzo/categoria
struct prodotto
{
string nome;
float prezzo;
string categoria;
};

void aggiungi( prodotto x, prodotto v[], int &d)
{
    
v[d] = x;
d++;
}

void visualizza ( prodotto v[], int d)
{
    for( int i = 0; i < d; i++)
    {
        cout <<"prodotto:" << i<<endl;
        
        cout << "nome:" << v[i].nome << endl;
        
        cout << "prezzo:" << v[i].prezzo << endl;
        
        cout << "categoria:" << v[i].categoria << endl;
    }
}

int cerca(prodotto x, prodotto v[], int d) {
    for (int i = 0; i < d; i++)
    {
        if (v[i].nome == x.nome) 
        { 
            return i;
        }
    }    
    return -1; 
}

/////////////////////////////////////////////////////////////////

bool cancella( prodotto x, prodotto v[], int &d)
{
    int pos = cerca(x, v, d);
    if (pos == -1)
        return false;

    for (int i = pos; i < d - 1; i++)
    {
        v[i] = v[i + 1];
    }

    d--;
    return true;
}

bool modifica( prodotto x, prodotto v[], int d)
{
    int pos = cerca(x, v, d);
    if (pos == -1)
        return false;

    cout << "Nuovo nome: ";
    cin.ignore();
    getline(cin, v[pos].nome);

    cout << "Nuova categoria: ";
    getline(cin, v[pos].categoria);

    cout << "Nuovo prezzo: ";
    cin >> v[pos].prezzo;

    return true;
}

